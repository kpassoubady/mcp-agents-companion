{
    "java.compile.nullAnalysis.mode": "disabled",
    "markdown.marp.themes": [
        "./assets/theme.css"
    ],
    "markdown.marp.html": "all",
    "github.copilot.advanced": {
        "excludeFiles": [
            "**/.env",
            "**/secrets/**"
        ]
    },
    "github.copilot.editor.enableAutoCompletions": true,
    "chat.editor.autoSuggest": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "markdown-pdf.margin.top": "2cm",
    "markdown-pdf.margin.bottom": "1.5cm",
    "markdown-pdf.margin.right": "1cm",
    "markdown-pdf.margin.left": "1cm",
    "markdown-pdf.headerTemplate": "<div style=\"font-size: 10px; width: 100%; text-align: center; color: #666; padding-top: 0.5cm;\"><span class='title'></span></div>",
    "markdown-pdf.footerTemplate": "<div style=\"font-size: 10px; width: 100%; display: flex; justify-content: space-between; color: #666; padding-left: 1cm; padding-right: 1cm; padding-bottom: 0.5cm;\"><span>Kangs | Kavin School</span><span><span class=\"pageNumber\"></span>/<span class=\"totalPages\"></span></span></div>",
    "markdown-pdf.scale": 1,
    "markdown-pdf.paperFormat": "a4",
    "markdown-pdf.orientation": "portrait",
    "markdown-pdf.displayHeaderFooter": true,
    "markdown-pdf.styles": [
        "./.vscode/markdown-pdf.css"
    ]
}